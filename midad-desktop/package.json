{
  "name": "midad-studio",
  "productName": "Midad Studio",
  "version": "1.0.1",
  "description": "مِداد ستوديو — استوديو تأليف الملازم الدراسية",
  "author": "مِداد",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --publish never",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always",
    "dist:portable": "electron-builder --win portable --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.midad.studio",
    "productName": "Midad Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "zulf96",
        "repo": "midad"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "unicode": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "مِداد ستوديو",
      "deleteAppDataOnUninstall": false
    }
  }
}
